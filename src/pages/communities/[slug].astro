---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/landing/Hero.astro';
import { getInitials } from '@/lib/placeholder';

// Generate static paths for all communities
export async function getStaticPaths() {
  const communities = await getCollection('communities');

  return communities.map((community) => ({
    params: { slug: community.id },
    props: { community },
  }));
}

const { community } = Astro.props;
const { Content } = await render(community);
---

<BaseLayout title={community.data.title}>
  <Hero />
  <article class="max-w-4xl mx-auto px-4 py-8">
    <!-- Hero Image -->
    {community.data.image ? (
      <Image
        src={community.data.image}
        alt={community.data.title}
        class="w-80 object-cover rounded-lg mb-8"
      />
    ) : (
      <div
        class="w-80 h-52 flex items-center justify-center rounded-lg mb-8 bg-[#3776ab] text-[#ffe873] text-5xl font-semibold"
        aria-label={community.data.title}
      >
        {getInitials(community.data.title)}
      </div>
    )}

    <!-- Title and Metadata -->
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{community.data.title}</h1>
      <div class="flex flex-wrap gap-4 text-gray-600 dark:text-gray-400">
        <span>📍 {community.data.city}, {community.data.country}</span>
        <span>🏷️ {community.data.category.join(', ')}</span>
        {community.data.website && (
          <span>🌐 <a href={community.data.website} class="hover:underline">{community.data.website}</a></span>
        )}
        {community.data.meetup && (
          <span>🤝 <a href={community.data.meetup} class="hover:underline">{community.data.meetup}</a></span>
        )}
        {community.data.luma && (
          <span>📅 <a href={community.data.luma} class="hover:underline">{community.data.luma}</a></span>
        )}
        {community.data.facebook && (
          <span>📘 <a href={community.data.facebook} class="hover:underline">{community.data.facebook}</a></span>
        )}
        {community.data.instagram && (
          <span>📷 <a href={community.data.instagram} class="hover:underline">{community.data.instagram}</a></span>
        )}
      </div>
      {community.data.description && (
        <blockquote class="text-xl text-gray-700 dark:text-gray-300 mt-4">{community.data.description}</blockquote>
      )}
    </header>

    <!-- Markdown Content -->
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <!-- Back Link -->
    <div class="mt-8">
      <a href="/" class="text-blue-600 dark:text-blue-400 hover:underline">
        ← Back to all communities
      </a>
    </div>
  </article>
</BaseLayout>

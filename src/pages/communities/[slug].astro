---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/landing/Hero.astro';

// Generate static paths for all communities
export async function getStaticPaths() {
  const communities = await getCollection('communities');
    // Debug: Log all entries
  console.log('All community IDs:', communities.map(c => c.id));

  return communities.map((community) => ({
    params: { slug: community.slug },
    props: { community },
  }));
}

const { community } = Astro.props;
const { Content } = await community.render();
---

<BaseLayout title={community.data.title}>
  <Hero />
  <article class="max-w-4xl mx-auto px-4 py-8">
    <!-- Hero Image -->
    <Image
      src={community.data.image}
      alt={community.data.title}
      width={800}
      height={600}
      class="w-full h-96 object-cover rounded-lg mb-8"
    />

    <!-- Title and Metadata -->
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{community.data.title}</h1>
      <div class="flex gap-4 text-gray-600">
        <span>📍 {community.data.city}</span>
        <span>🏷️ {community.data.category}</span>
      </div>
      {community.data.description && (
        <p class="text-xl text-gray-700 mt-4">{community.data.description}</p>
      )}
    </header>

    <!-- Markdown Content -->
    <div class="prose prose-lg max-w-none">
      <Content />
    </div>

    <!-- Back Link -->
    <div class="mt-8">
      <a href="/" class="text-blue-600 hover:underline">
        ← Back to all communities
      </a>
    </div>
  </article>
</BaseLayout>

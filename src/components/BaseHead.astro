---
import '../styles/global.css';
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Basic Meta Tags -->
<title>Unofficial Python Worldwide Communities Index</title>
<meta
  name="description"
  content="A gallery of all the Python Communities."
/>
<meta name="keywords" content="Python, Python communities, PyLadies, PyData, meetup, user groups, PyCon" />
<meta name="author" content="Cristián Maureira-Fredes" />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Favicon for IE -->
<link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />

<!-- Favicons for different sizes -->
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://pycommunities.palta.cc/" />
<meta property="og:site_name" content="Unofficial Python Worldwide Communities Index" />
<meta property="og:title" content="Unofficial Python Worldwide Communities Index" />
<meta
  property="og:description"
  content="An unofficial, but enthusiastic showcase of Python communities, organizations, and events from around the world."
/>
<meta
  property="og:image"
  content="https://pycommunities.palta.cc/og-image.png"
/>
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Unofficial Python Worldwide Communities Index" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://pycommunities.palta.cc/" />
<meta property="twitter:title" content="Unofficial Python Worldwide Communities Index" />
<meta
  property="twitter:description"
  content="An unofficial, but enthusiastic Python Worldwide Communities Index."
/>
<meta
  property="twitter:image"
  content="https://pycommunities.palta.cc/og-image.png"
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://pycommunities.palta.cc/" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Apple Touch Icon (already included in favicons, but keeping for backwards compatibility) -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#2E6291" />

<!-- For IE -->
<meta http-equiv="X-UA-Compatible" content="IE=edge" />



<!-- HTML in your document's head -->
<link rel="preconnect" href="https://rsms.me/" />
<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />

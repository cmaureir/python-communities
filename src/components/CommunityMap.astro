---
import { getCollection } from 'astro:content';

const communities = await getCollection('communities');

// You'll need to geocode cities to coordinates
// For now, create a manual mapping or use a geocoding API
const rawLocations = communities.map(community => ({
  id: community.id,
  name: community.data.title,
  city: community.data.city,
  country: community.data.country,
  url: `/communities/${community.id.replace('/index.md', '')}`,
  lng: Number(community.data.longitude),
  lat: Number(community.data.latitude),
}));

// Several communities can share the same (or near-identical) coordinates,
// e.g. multiple groups in the same city. Left as-is, their map pins stack
// exactly on top of each other and only the topmost one is ever visible or
// clickable. Nudge same-spot pins into a small circle around the real point
// so zooming in reveals and lets you click every one of them individually.
// This only affects where the pin is drawn — the stored lat/lng data (shown
// on each community's own page) is untouched.
const coordinateGroups = new Map<string, typeof rawLocations>();
for (const location of rawLocations) {
  const key = `${location.lat.toFixed(3)},${location.lng.toFixed(3)}`;
  if (!coordinateGroups.has(key)) coordinateGroups.set(key, []);
  coordinateGroups.get(key)!.push(location);
}

const JITTER_RADIUS_DEGREES = 0.02;
const communityLocations = [...coordinateGroups.values()].flatMap(group => {
  if (group.length === 1) return group;

  const latitudeRadians = (group[0].lat * Math.PI) / 180;
  return group.map((location, index) => {
    const angle = (2 * Math.PI * index) / group.length;
    return {
      ...location,
      lat: location.lat + JITTER_RADIUS_DEGREES * Math.cos(angle),
      // Longitude degrees shrink as they get closer to the poles, so
      // widen the offset to keep the circle visually round everywhere.
      lng: location.lng + (JITTER_RADIUS_DEGREES * Math.sin(angle)) / Math.cos(latitudeRadians),
    };
  });
});
---

<div id="map" class="w-full dark:ring-1 dark:ring-white/10" style="height: 400px;"></div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script is:inline define:vars={{ communityLocations }}>
    document.addEventListener('DOMContentLoaded', () => {
    const map = L.map('map', {
      maxBounds: [[-90, -180], [90, 180]],
      maxBoundsViscosity: 1.0,
      zoomSnap: 0.1
    }).setView([20, 0], 2);

    // Fit the zoom so the single world copy always spans the container's
    // width (no gray gutters), even though that crops the poles vertically.
    const fitZoomToWidth = () => {
      const containerWidth = map.getSize().x;
      if (!containerWidth) return;
      const zoom = Math.log2(containerWidth / 256);
      map.setMinZoom(zoom);
      map.setZoom(zoom);
    };

    fitZoomToWidth();
    window.addEventListener('resize', () => {
      map.invalidateSize();
      fitZoomToWidth();
    });

    // A single OpenStreetMap tile source for both themes — dark mode is
    // achieved with a CSS filter (see below) rather than a separate dark
    // tile provider, since those (e.g. Carto) require a registered API key
    // for their basemap tiles now and show an "API KEY REQUIRED" watermark
    // without one.
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      noWrap: true
    }).addTo(map);

    const markersById = new Map();
    communityLocations.forEach(community => {
      const marker = L.marker([community.lat, community.lng]).addTo(map);
      marker.bindPopup(`
        <strong><a href="${community.url}">${community.name}</a></strong><br>
        ${community.city}, ${community.country}
      `);
      markersById.set(community.id, marker);
    });

    window.addEventListener('communities-filtered', (event) => {
      const visibleIds = new Set(event.detail.ids);
      markersById.forEach((marker, id) => {
        const shouldShow = visibleIds.has(id);
        const isShown = map.hasLayer(marker);
        if (shouldShow && !isShown) {
          marker.addTo(map);
        } else if (!shouldShow && isShown) {
          map.removeLayer(marker);
        }
      });
    });
  });
</script>

<style>
  #map {
    border-radius: 8px;
  }

  /* Derives a dark map from the light OpenStreetMap tiles: inverting
     flips light/dark (and every hue to its complement), then rotating
     hue by 180deg brings the colors back close to their original tone. */
  :global(.dark .leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) brightness(0.85) contrast(0.9) saturate(0.9);
  }

  :global(.dark .leaflet-popup-content-wrapper),
  :global(.dark .leaflet-popup-tip) {
    background: #27272a;
    color: #f4f4f5;
  }
  :global(.dark .leaflet-popup-content a) {
    color: #93c5fd;
  }
  :global(.dark .leaflet-control-zoom a) {
    background: #27272a;
    color: #f4f4f5;
    border-color: #3f3f46;
  }
  :global(.dark .leaflet-control-attribution) {
    background: rgba(39, 39, 42, 0.8);
    color: #d4d4d8;
  }
  :global(.dark .leaflet-control-attribution a) {
    color: #93c5fd;
  }
</style>

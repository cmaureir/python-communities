---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import SearchBox from '@components/SearchBox.astro';
import { placeholderImage } from '@/lib/placeholder';

const items = await getCollection('communities');

const regionNames = new Intl.DisplayNames(['en'], { type: 'region' });

const communities = await Promise.all(
    items.map(async (entry) => {
        const image = entry.data.image
            ? (await getImage({ src: entry.data.image, width: 600, height: 400 })).src
            : placeholderImage(entry.data.title);

        return {
            id: entry.id, // Auto-generated from filename
            title: entry.data.title,
            city: entry.data.city,
            country: entry.data.country,
            countryName: regionNames.of(entry.data.country) ?? entry.data.country,
            category: entry.data.category,
            inactive: entry.data.inactive === 'yes',
            description: entry.data.description,
            image,
            url: `/communities/${entry.id.replace('/index.md', '')}`,
        };
    })
);

const categories = [...new Set(items.flatMap(item => item.data.category))].sort();
const countries = [...new Set(items.map(item => item.data.country))];

const countryNames = Object.fromEntries(
    countries.map(code => [code, regionNames.of(code) ?? code])
);

countries.sort((a, b) => countryNames[a].localeCompare(countryNames[b]));
---

<section class="mt-4">

<script define:vars={{ communities }} is:inline>

  document.addEventListener('alpine:init', () => {
    Alpine.store('search', {
      filteredItems: [],
      allItems: communities,
      currentPage: 1,
      pageSize: 12,
      get totalPages() {
        return Math.max(1, Math.ceil(this.filteredItems.length / this.pageSize));
      },
      get pagedItems() {
        const start = (this.currentPage - 1) * this.pageSize;
        return this.filteredItems.slice(start, start + this.pageSize);
      }
    });
  });
</script>
<div x-data="{
  goToPage(page) {
    $store.search.currentPage = Math.min(Math.max(1, page), $store.search.totalPages);
    document.getElementById('communities-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
}">
  <SearchBox items={communities} categories={categories} countries={countries} countryNames={countryNames} />

  <div
    id="communities-grid"
    class="grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-6 pt-12"
  >
    <template x-for="community in $store.search.pagedItems" :key="community.id">
        <a :href="community.url" class="group block rounded-xl p-3 -m-3 transition-colors hover:bg-zinc-100 dark:hover:bg-zinc-800/60">
          <div class="aspect-12/9 rounded-xl overflow-hidden bg-zinc-50 dark:bg-zinc-900 mb-4">
            <img
              :alt="community.title"
              :src="community.image"
              class="w-full h-full object-contain p-6 transition duration-300 group-hover:scale-[1.03]"
            />
          </div>
          <div class="flex flex-wrap items-center gap-1.5 mb-1.5">
            <template x-for="cat in community.category" :key="cat">
              <span class="text-[11px] px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400" x-text="cat"></span>
            </template>
            <span class="text-[11px] text-zinc-400 dark:text-zinc-500" x-text="community.countryName"></span>
          </div>
          <p class="text-base font-medium text-zinc-800 dark:text-zinc-100" x-text="community.title"></p>
          <p class="text-sm text-zinc-400 dark:text-zinc-500 mb-2" x-text="`${community.city}, ${community.countryName}`"></p>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed" x-text="community.description"></p>
        </a>
      </template>
  </div>

  <!-- Pagination -->
  <div class="flex items-center justify-center gap-4 py-12" x-show="$store.search.totalPages > 1">
    <button
      @click="goToPage($store.search.currentPage - 1)"
      :disabled="$store.search.currentPage === 1"
      class="px-4 py-2 rounded-md border border-gray-300 dark:border-zinc-600 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed hover:bg-gray-50 dark:hover:bg-zinc-800 transition-colors"
    >
      Previous
    </button>
    <span class="text-sm text-zinc-500 dark:text-zinc-400">
      Page <span x-text="$store.search.currentPage"></span> of <span x-text="$store.search.totalPages"></span>
    </span>
    <button
      @click="goToPage($store.search.currentPage + 1)"
      :disabled="$store.search.currentPage === $store.search.totalPages"
      class="px-4 py-2 rounded-md border border-gray-300 dark:border-zinc-600 text-sm font-medium disabled:opacity-40 disabled:cursor-not-allowed hover:bg-gray-50 dark:hover:bg-zinc-800 transition-colors"
    >
      Next
    </button>
  </div>
</div>
</section>

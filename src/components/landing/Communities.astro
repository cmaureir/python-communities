---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import SearchBox from '@components/SearchBox.astro';
import { placeholderImage } from '@/lib/placeholder';

const items = await getCollection('communities');

const communities = await Promise.all(
    items.map(async (entry) => {
        const image = entry.data.image
            ? (await getImage({ src: entry.data.image, width: 600, height: 400 })).src
            : placeholderImage(entry.data.title);

        return {
            id: entry.id, // Auto-generated from filename
            title: entry.data.title,
            city: entry.data.city,
            country: entry.data.country,
            category: entry.data.category,
            description: entry.data.description,
            image,
            url: `/communities/${entry.id.replace('/index.md', '')}`,
        };
    })
);

const categories = [...new Set(items.map(item => item.data.category))];
const countries = [...new Set(items.map(item => item.data.country))].sort();

const regionNames = new Intl.DisplayNames(['en'], { type: 'region' });
const countryNames = Object.fromEntries(
    countries.map(code => [code, regionNames.of(code) ?? code])
);
---

<section class="mt-4">

<script define:vars={{ communities }} is:inline>

  document.addEventListener('alpine:init', () => {
    Alpine.store('search', {
      filteredItems: [],
      allItems: communities
    });
  });
</script>
<div x-data>
  <SearchBox items={communities} categories={categories} countries={countries} countryNames={countryNames} />

  <div
    class="grid grid-cols-1 gap-3 lg:gap-y-12 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-6 py-12"
  >
    <template x-for="community in $store.search.filteredItems" :key="community.id">
        <figure class="relative rounded-2xl p-2 hover:bg-blue-50 dark:hover:bg-zinc-800">
          <a :href="community.url" aria-hidden="true" class="absolute inset-0" />
          <img
            :alt="community.title"
            :src="community.image"
            class="w-full rounded-2xl shadow aspect-12/9 object-contain bg-gray-50 dark:bg-zinc-900 p-5"
          />
          <div class="mt-2 px-6">
             <p class="text-md font-medium" x-text="community.title"/>
             <p class="text-sm text-zinc-500 dark:text-zinc-400" x-text="`${community.city}, ${community.country}`"/>
             <h3 class="text-xs text-base-500 mt-1" x-text="community.description"></h3>
          </div>
        </figure>
      </template>
  </div>
</div>
</section>

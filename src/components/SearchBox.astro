---
// SearchBox.astro
interface Item {
  id: string;
  title: string;
  city: string;
  country: string;
  category: string[];
  inactive: boolean;
  description?: string;
}

interface Props {
  items: Item[];
  categories: string[];
  countries: string[];
  countryNames: Record<string, string>;
}

const { items, categories, countries, countryNames } = Astro.props;
---

<div
  x-data={`{
    searchQuery: '',
    selectedCategory: 'all',
    selectedCountry: 'all',
    includeInactive: true,
    showPreview: false,
    items: ${JSON.stringify(items)},
    countryNames: ${JSON.stringify(countryNames)},

    init() {
      this.$store.search.allItems = this.items;
      this.$store.search.filteredItems = this.items;
      this.computePageSize();
      window.addEventListener('resize', () => this.computePageSize());
      this.updateFilters();
    },

    computePageSize() {
      const w = window.innerWidth;
      let columns = 1;
      if (w >= 1536) columns = 6;
      else if (w >= 1280) columns = 4;
      else if (w >= 1024) columns = 3;
      else if (w >= 768) columns = 2;

      const size = columns === 1 ? 5 : columns * 2;
      if (size !== this.$store.search.pageSize) {
        this.$store.search.pageSize = size;
        this.$store.search.currentPage = 1;
      }
    },

    updateFilters() {
      let filtered = this.items;

      // Filter out inactive communities unless included
      if (!this.includeInactive) {
        filtered = filtered.filter(item => !item.inactive);
      }

      // Filter by category
      if (this.selectedCategory !== 'all') {
        filtered = filtered.filter(item =>
          item.category.includes(this.selectedCategory)
        );
      }

      // Filter by country
      if (this.selectedCountry !== 'all') {
        filtered = filtered.filter(item =>
          item.country === this.selectedCountry
        );
      }

      // Filter by search query
      if (this.searchQuery.trim()) {
        const query = this.searchQuery.toLowerCase();
        filtered = filtered.filter(item =>
          item.title.toLowerCase().includes(query) ||
          item.city.toLowerCase().includes(query) ||
          item.country.toLowerCase().includes(query) ||
          item.category.some(cat => cat.toLowerCase().includes(query)) ||
          (item.description && item.description.toLowerCase().includes(query))
        );
      }

      // Update the store
      this.$store.search.filteredItems = filtered;

      window.dispatchEvent(
        new CustomEvent('communities-filtered', { detail: { ids: filtered.map(item => item.id) } })
      );

      return filtered;
    },

    get filteredItems() {
      return this.updateFilters();
    },

    get previewItems() {
      return this.filteredItems.slice(0, 5);
    },

    handleSearch() {
      this.showPreview = false;
      // Handle search submit - you can emit an event or navigate
      console.log('Searching for:', this.searchQuery, 'in category:', this.selectedCategory);
      console.log('Results:', this.filteredItems);
    },

    selectItem(item) {
      this.searchQuery = item.title;
      this.showPreview = false;
      // Handle item selection
      console.log('Selected item:', item);
    }
  }`}
  @click.away="showPreview = false"
  class="w-full max-w-7xl 2xl:max-w-[100rem] mx-auto"
>
<div class="bg-white dark:bg-zinc-800 rounded-lg shadow-lg dark:shadow-none dark:ring-1 dark:ring-white/10 p-6">
    <div class="flex flex-col md:flex-row gap-4">

      <!-- Category Filter -->
      <div class="md:w-48">
        <label for="category" class="block text-sm font-medium mb-2">
          Category
        </label>
        <select
          id="category"
          x-model="selectedCategory"
          @change="$store.search.currentPage = 1; updateFilters()"
          class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100 rounded-sm focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent outline-none"
        >
          <option value="all">All Categories</option>
          {categories.map(category => (
            <option value={category}>{category}</option>
          ))}
        </select>
      </div>

      <!-- Country Filter -->
      <div class="md:w-48">
        <label for="country" class="block text-sm font-medium mb-2">
          Country
        </label>
        <select
          id="country"
          x-model="selectedCountry"
          @change="$store.search.currentPage = 1; updateFilters()"
          class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100 rounded-sm focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent outline-none"
        >
          <option value="all">All Countries</option>
          {countries.map(country => (
            <option value={country}>{countryNames[country] ?? country}</option>
          ))}
        </select>
      </div>

      <!-- Search Input with Preview -->
      <div class="flex-1 relative">
        <label for="search" class="block text-sm font-medium mb-2">
          Search
        </label>
        <div class="flex gap-2">
          <div class="relative flex-1">
            <input
              id="search"
              type="text"
              x-model="searchQuery"
              @input="showPreview = searchQuery.length > 0; $store.search.currentPage = 1; updateFilters()"
              @focus="showPreview = searchQuery.length > 0"
              @keydown.enter="handleSearch()"
              @keydown.escape="showPreview = false"
              placeholder="Search by title, city, category..."
              class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100 rounded-sm focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:border-transparent outline-none"
            />

            <!-- Search Preview Dropdown -->
            <div
              x-show="showPreview && previewItems.length > 0"
              x-transition
              class="absolute z-10 w-full mt-2 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-sm shadow-lg max-h-80 overflow-y-auto"
            >
              <template x-for="item in previewItems" :key="item.id">
                <button
                  @click="selectItem(item)"
                  class="w-full px-4 py-3 text-left hover:bg-gray-50 dark:hover:bg-zinc-700 border-b border-gray-100 dark:border-zinc-700 last:border-b-0 transition-colors"
                >
                  <div class="font-medium text-gray-900 dark:text-zinc-100" x-text="item.title"></div>
                  <div class="text-sm text-gray-500 dark:text-zinc-400 mt-1">
                    <span x-text="item.city"></span>
                    <span class="mx-2">•</span>
                    <span x-text="item.category.join(', ')"></span>
                  </div>
                </button>
              </template>

              <div
                x-show="filteredItems.length > 5"
                class="px-4 py-2 text-sm text-gray-500 dark:text-zinc-400 bg-gray-50 dark:bg-zinc-900/50 text-center"
              >
                <span x-text="`${filteredItems.length - 5} more results...`"></span>
              </div>
            </div>

            <!-- No Results Message -->
            <div
              x-show="showPreview && searchQuery.length > 0 && filteredItems.length === 0"
              x-transition
              class="absolute z-10 w-full mt-2 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-sm shadow-lg p-4"
            >
              <p class="text-gray-500 dark:text-zinc-400 text-center">No results found</p>
            </div>
          </div>

          <!-- Search Button -->
          <button
            @click="handleSearch()"
            class="px-6 py-2 bg-blue-600 dark:bg-blue-500 text-white font-medium rounded-md hover:bg-blue-700 dark:hover:bg-blue-600 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-colors"
          >
            Search
          </button>
        </div>
      </div>
    </div>

    <!-- Results Count -->
    <div class="mt-4 flex items-center justify-between text-sm text-gray-600 dark:text-zinc-400">
      <div>
        <strong x-text="filteredItems.length"></strong>&nbsp;
        <span x-text="filteredItems.length === 1 ? 'community' : 'communities'"></span>
        <span x-show="selectedCategory !== 'all'"> in <span x-text="selectedCategory"></span></span>
        <span x-show="selectedCountry !== 'all'"> in <span x-text="countryNames[selectedCountry] ?? selectedCountry"></span></span>
      </div>

      <!-- Include Inactive Toggle -->
      <label class="flex items-center gap-2 font-medium cursor-pointer select-none whitespace-nowrap">
        <input
          type="checkbox"
          x-model="includeInactive"
          @change="$store.search.currentPage = 1; updateFilters()"
          class="size-4 rounded border-gray-300 dark:border-zinc-600 text-blue-600 dark:text-blue-500 focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400"
        />
        Include Inactive Communities
      </label>
    </div>
  </div>
</div>

<script>
  // Make sure Alpine.js is loaded
  import Alpine from 'alpinejs';

  if (!window.Alpine) {
    window.Alpine = Alpine;
    Alpine.start();
  }
</script>

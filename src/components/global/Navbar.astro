---
import ThemeIcon from '@/components/ThemeIcon.astro';

const pathname = Astro.url.pathname;
const isCommunities = pathname === '/' || pathname.startsWith('/communities/');
const isContributing = pathname === '/contributing';

const linkBase = 'rounded-md px-3 py-2 text-sm font-medium transition-colors';
const linkInactive = 'text-gray-700 dark:text-gray-300 hover:bg-gray-900/5 dark:hover:bg-white/5 hover:text-gray-900 dark:hover:text-white';
const linkActive = 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-500/10';

const mobileLinkBase = 'block rounded-md px-3 py-2 text-base font-medium transition-colors';
const mobileLinkInactive = 'text-gray-600 dark:text-gray-300 hover:bg-gray-900/5 dark:hover:bg-white/5 hover:text-gray-900 dark:hover:text-white';
const mobileLinkActive = 'text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-500/10';

const externalLink = 'inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-900/5 dark:hover:bg-white/5 hover:text-gray-900 dark:hover:text-white transition-colors';
const mobileExternalLink = 'flex items-center gap-1 rounded-md px-3 py-2 text-base font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-900/5 dark:hover:bg-white/5 hover:text-gray-900 dark:hover:text-white transition-colors';

const externalLinks = [
  { href: 'https://github.com/cmaureir/python-communities', label: 'Check the code' },
  { href: 'https://pycon.org', label: 'PyCons' },
  { href: 'https://python.pizza', label: 'Python Pizza' },
];
---
<nav class="relative after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-gray-900/10 dark:after:bg-white/10">
  <div class="mx-auto max-w-7xl 2xl:max-w-[100rem] px-2 sm:px-6 lg:px-8">
    <div class="relative flex h-16 items-center justify-between">
      <div class="absolute inset-y-0 left-0 flex items-center sm:hidden">
        <!-- Mobile menu button-->
        <button type="button" id="mobile-menu-button" aria-controls="mobile-menu" aria-expanded="false" class="relative inline-flex items-center justify-center rounded-md p-2 hover:bg-gray-900/5 dark:hover:bg-white/5 hover:text-gray-900 dark:hover:text-white focus:outline-2 focus:-outline-offset-1 focus:outline-indigo-500">
          <span class="absolute -inset-0.5"></span>
          <span class="sr-only">Open main menu</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 in-aria-expanded:hidden">
            <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="size-6 not-in-aria-expanded:hidden">
            <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <div class="flex flex-1 items-center justify-center sm:items-stretch sm:justify-start">
        <div class="flex shrink-0 items-center">
          <a href="/" aria-label="Python Communities home" class="flex items-center opacity-90 hover:opacity-100 transition-opacity">
            <img src="https://docs.python.org/3/_static/py.svg" alt="Python Communities" class="h-8 w-auto" />
          </a>
        </div>
        <div class="hidden sm:ml-6 sm:block">
          <div class="flex space-x-4">
            <a href="/" aria-current={isCommunities ? 'page' : undefined} class={`${linkBase} ${isCommunities ? linkActive : linkInactive}`}>Communities</a>
            <a href="/contributing" aria-current={isContributing ? 'page' : undefined} class={`${linkBase} ${isContributing ? linkActive : linkInactive}`}>How to Contribute</a>
          </div>
        </div>
      </div>
      <div class="hidden sm:flex sm:items-center sm:gap-2">
        <div class="flex items-center gap-1">
          {externalLinks.map(link => (
            <a href={link.href} target="_blank" rel="noopener noreferrer" class={externalLink}>
              {link.label}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-3.5 text-amber-500">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            </a>
          ))}
        </div>
        <span class="h-5 w-px bg-gray-900/10 dark:bg-white/10"></span>
      </div>
      <ThemeIcon/>
    </div>
  </div>

  <div id="mobile-menu" hidden class="block sm:hidden">
    <div class="space-y-1 px-2 pt-2 pb-3">
      <a href="/" aria-current={isCommunities ? 'page' : undefined} class={`${mobileLinkBase} ${isCommunities ? mobileLinkActive : mobileLinkInactive}`}>Communities</a>
      <a href="/contributing" aria-current={isContributing ? 'page' : undefined} class={`${mobileLinkBase} ${isContributing ? mobileLinkActive : mobileLinkInactive}`}>How to Contribute</a>
    </div>
    <div class="space-y-1 border-t border-gray-900/10 dark:border-white/10 px-2 pt-2 pb-3">
      {externalLinks.map(link => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class={mobileExternalLink}>
          {link.label}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="size-3.5 text-amber-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      ))}
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!button || !menu) return;

    button.addEventListener('click', () => {
      const willOpen = menu.hidden;
      menu.hidden = !willOpen;
      button.setAttribute('aria-expanded', String(willOpen));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.hidden = true;
        button.setAttribute('aria-expanded', 'false');
      });
    });
  });
</script>

